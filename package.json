{
  "name": "backend-challenge",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "src/main.ts",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "bun test",
    "test:integration": "bun test --env-file=.env.test --timeout 60000 --path-ignore-patterns=node_modules test/integration",
    "test:concurrency": "bun test --env-file=.env.test --timeout 120000 --path-ignore-patterns=node_modules test/concurrency",
    "test:load": "bun test/load/run.ts",
    "test:infra:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:infra:down": "docker compose -f docker-compose.test.yml down -v",
    "migration:create": "bunx mikro-orm migration:create",
    "migration:up": "bun src/shared/infra/persistence/migrate.ts up",
    "migration:down": "bun src/shared/infra/persistence/migrate.ts down",
    "migration:list": "bun src/shared/infra/persistence/migrate.ts list"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1119.0",
    "@mikro-orm/core": "^6",
    "@mikro-orm/migrations": "^6",
    "@mikro-orm/nestjs": "^6",
    "@mikro-orm/postgresql": "^6",
    "@nestjs/common": "^11",
    "@nestjs/core": "^11",
    "@nestjs/platform-express": "^11",
    "@nestjs/terminus": "^11",
    "decimal.js": "^10.6.0",
    "nestjs-pino": "^4.6.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuidv7": "^1.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@mikro-orm/cli": "^6",
    "@nestjs/testing": "^11",
    "@types/bun": "latest",
    "pino-pretty": "^13.1.3",
    "typescript": "~5.9.0"
  },
  "mikro-orm": {
    "useTsNode": true,
    "configPaths": [
      "./mikro-orm.config.ts"
    ]
  }
}
